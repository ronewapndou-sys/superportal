{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/cxo/*"],
      "next/link": ["src/cxo/shims/next-link.tsx"],
      "next/navigation": ["src/cxo/shims/next-navigation.ts"],
      "next/image": ["src/cxo/shims/next-image.tsx"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
